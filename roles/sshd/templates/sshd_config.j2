# Managed by Ansible — do not edit manually
# Include is placed at the end of this file (see bottom) rather than the top:
# sshd_config uses first-obtained-value-wins, so drop-ins in
# /etc/ssh/sshd_config.d/ (RPM defaults, Anaconda, ipa-client-install, etc.)
# only fill in settings this file doesn't already set — they can't silently
# override the hardening below.

# ---- Connection ----
Port {{ sshd_port }}
AddressFamily {{ sshd_address_family }}
{% for addr in sshd_listen_addresses %}
ListenAddress {{ addr }}
{% endfor %}

# ---- Logging ----
SyslogFacility AUTH
LogLevel {{ sshd_log_level }}

# ---- Authentication ----
LoginGraceTime {{ sshd_login_grace_time }}
PermitRootLogin {{ sshd_permit_root_login }}
StrictModes yes
MaxAuthTries {{ sshd_max_auth_tries }}
MaxSessions {{ sshd_max_sessions }}

PubkeyAuthentication {{ sshd_pubkey_authentication }}
AuthorizedKeysFile {{ sshd_authorized_keys_file }}
{% if sshd_authorized_keys_command %}
AuthorizedKeysCommand {{ sshd_authorized_keys_command }}
AuthorizedKeysCommandUser {{ sshd_authorized_keys_command_user }}
{% endif %}

HostbasedAuthentication no
IgnoreUserKnownHosts no
IgnoreRhosts yes

PasswordAuthentication {{ sshd_password_authentication }}
PermitEmptyPasswords {{ sshd_permit_empty_passwords }}

KerberosAuthentication no
GSSAPIAuthentication no

UsePAM {{ sshd_use_pam }}

# ---- Session ----
AllowTcpForwarding {{ sshd_allow_tcp_forwarding }}
AllowAgentForwarding {{ sshd_allow_agent_forwarding }}
AllowStreamLocalForwarding {{ sshd_allow_stream_local_forwarding }}
X11Forwarding {{ sshd_x11_forwarding }}
{% if sshd_allow_tcp_forwarding == 'no' and sshd_allow_agent_forwarding == 'no' and sshd_allow_stream_local_forwarding == 'no' and sshd_x11_forwarding == 'no' %}
{# DisableForwarding is the CIS-checked consolidated directive; only claim it when every granular type is actually off, since it overrides them all. #}
DisableForwarding yes
{% endif %}
MaxStartups {{ sshd_max_startups }}
PrintMotd {{ sshd_print_motd }}
ClientAliveInterval {{ sshd_client_alive_interval }}
ClientAliveCountMax {{ sshd_client_alive_count_max }}
PermitUserEnvironment no
Compression no
{% if sshd_banner %}
Banner {{ sshd_banner }}
{% endif %}

# ---- Subsystem ----
Subsystem sftp {{ _sshd_sftp_server }}

# ---- Access control ----
{% if sshd_deny_users %}
DenyUsers {{ sshd_deny_users | join(' ') }}
{% endif %}
{% if sshd_allow_users %}
AllowUsers {{ sshd_allow_users | join(' ') }}
{% endif %}
{% if sshd_deny_groups %}
DenyGroups {{ sshd_deny_groups | join(' ') }}
{% endif %}
{% if sshd_allow_groups %}
AllowGroups {{ sshd_allow_groups | join(' ') }}
{% endif %}

# ---- Match blocks ----
{% for block in sshd_match_blocks %}
Match {{ block.type }} {{ block.targets | join(' ') }}
{% for opt in block.options %}
  {{ opt }}
{% endfor %}
{% endfor %}

# ---- Drop-ins ----
# Placed last so first-obtained-value-wins semantics keep the hardening above
# authoritative; drop-ins only supply settings not already set (e.g. IPA's
# AuthorizedKeysCommand, crypto-policies backend Include).
Include /etc/ssh/sshd_config.d/*.conf
